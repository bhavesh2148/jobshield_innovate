logs/
*.log
sec_out.txt
*.tmp
scratch/

# ── Large Data Files & Datasets ─────────────────────────────────
data/raw/*.csv
data/raw/*.tsv
data/raw/*.json
data/processed/*.npy
data/processed/*.parquet
data/processed/*.pkl
data/pseudo_labeled/*.npy

# ── ML Model Weights & Large Binaries (>50MB) ────────────────────
# BERT model weights are huge — auto-downloaded from HuggingFace at runtime
models/bert/model.safetensors
models/bert/pytorch_model.bin
models/**/*.pt
models/**/*.onnx
# NOTE: xgb_model.pkl (~1.5MB), lr_model.pkl (~1KB), faiss_index.bin (~1.3MB)
# and faiss_metadata.pkl (~180KB) ARE committed — they are required for the
# backend to start. Without them, AppState.init() fails on fresh clone.

# ── OS Generated Files ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

